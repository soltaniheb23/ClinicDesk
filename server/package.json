{
  "name": "clinicdesk-server",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "lint": "eslint .",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@sentry/node": "^11.20.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.13.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.6.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.4.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text-summary",
      "text",
      "lcov"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 80,
        "branches": 80,
        "functions": 80,
        "lines": 80
      }
    }
  }
}
