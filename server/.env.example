# Copy to server/.env and fill in. Never commit server/.env or real values.

# Server port
PORT=3000

# Frontend origins allowed to call the API (CORS). Comma-separated, exact origins only
# (scheme + host + port, no path). "*" is refused at startup.
# Example: https://clinicdesk.vercel.app,https://staging-clinicdesk.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# MongoDB connection string, required (never commit the real value)
MONGODB_URI=

# Secret used to sign login tokens (JWT). Required in production and at least 32
# characters; generate one with
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
# Never commit the real value.
JWT_SECRET=

# How long a login token stays valid (e.g. 15m, 1h, 1d)
JWT_EXPIRES_IN=1h

# How many proxies sit in front of the API, so rate limits see the real client IP.
# Leave empty for the default: 1 in production (Render), "false" everywhere else.
# Never "true": that would let clients choose their own IP.
TRUST_PROXY=

# "true" only behind Cloudflare (Render): the rate limits then use the CF-Connecting-IP
# header as the client IP (when it is a valid IP address) instead of X-Forwarded-For.
# The header is spoofable on any host reachable without Cloudflare, so leave it "false"
# (the default) everywhere else, including local development.
TRUST_CF_CONNECTING_IP=false

# TEMPORARY: "true" logs one line per failed login with req.ip, req.ips, X-Forwarded-For,
# CF-Connecting-IP and the socket address, to confirm the proxy setup. Never the email or
# password. Keep "false"; this setting will be removed once the setup is confirmed.
DEBUG_CLIENT_IP=false

# Rate limits per client IP (leave empty for the defaults). Windows are in milliseconds.
# Failed logins: 10 per 15 minutes. Registrations: 5 per hour. Whole API: 300 per 15 minutes.
RATE_LIMIT_LOGIN_MAX=
RATE_LIMIT_LOGIN_WINDOW_MS=
RATE_LIMIT_REGISTER_MAX=
RATE_LIMIT_REGISTER_WINDOW_MS=
RATE_LIMIT_GLOBAL_MAX=
RATE_LIMIT_GLOBAL_WINDOW_MS=

# Email notifications on new tickets and replies (docs/notifications.md). Off by default.
# When EMAIL_ENABLED=true, every variable below is required, or the server stops at startup.
# Use a sandbox (for example Mailtrap) on staging. Never commit real credentials.
EMAIL_ENABLED=false
SMTP_HOST=
# 587 (STARTTLS) or 465 (TLS)
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# Sender, for example: ClinicDesk <no-reply@example.com>
MAIL_FROM=
# The client's URL, used for ticket links, for example: https://clinicdesk.vercel.app
APP_URL=

# Error monitoring with Sentry (docs/monitoring.md). Off while SENTRY_DSN is empty. The DSN is
# from Sentry: Project Settings > Client Keys (DSN). It must be an https URL, or the server
# stops at startup. Set it in the Render dashboard only; never commit a real DSN.
SENTRY_DSN=
# Optional environment tag in Sentry (for example staging). Empty: NODE_ENV.
SENTRY_ENVIRONMENT=
