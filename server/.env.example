# Copy to server/.env and fill in. Never commit server/.env or real values.

# Server port
PORT=3000

# Frontend origins allowed to call the API (CORS). Comma-separated, exact origins only
# (scheme + host + port, no path). "*" is refused at startup.
# Example: https://clinicdesk.vercel.app,https://staging-clinicdesk.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# MongoDB connection string, required (never commit the real value)
MONGODB_URI=

# Secret used to sign login tokens (JWT). Required in production and at least 32
# characters; generate one with
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
# Never commit the real value.
JWT_SECRET=

# How long a login token stays valid (e.g. 15m, 1h, 1d)
JWT_EXPIRES_IN=1h

# How many proxies sit in front of the API, so rate limits see the real client IP.
# Leave empty for the default: 1 in production (Render), "false" everywhere else.
# Never "true": that would let clients choose their own IP.
TRUST_PROXY=

# Rate limits per client IP (leave empty for the defaults). Windows are in milliseconds.
# Failed logins: 10 per 15 minutes. Registrations: 5 per hour. Whole API: 300 per 15 minutes.
RATE_LIMIT_LOGIN_MAX=
RATE_LIMIT_LOGIN_WINDOW_MS=
RATE_LIMIT_REGISTER_MAX=
RATE_LIMIT_REGISTER_WINDOW_MS=
RATE_LIMIT_GLOBAL_MAX=
RATE_LIMIT_GLOBAL_WINDOW_MS=
