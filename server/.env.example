# Server port
PORT=3000

# URL of the React client allowed to call the API (CORS)
CLIENT_ORIGIN=http://localhost:5173

# MongoDB connection string, required (never commit the real value)
MONGODB_URI=

# Secret used to sign login tokens (JWT). Required in production; use a long
# random value, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
# Never commit the real value.
JWT_SECRET=

# How long a login token stays valid (e.g. 15m, 1h, 1d)
JWT_EXPIRES_IN=1h

# URL of the API (leave empty in local development, the Vite proxy is used)
VITE_API_URL=
