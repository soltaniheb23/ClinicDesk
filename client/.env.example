# URL of the API. Leave empty in local development (the Vite proxy is used).
VITE_API_URL=

# Error monitoring with Sentry (docs/monitoring.md). Off while empty. Use the DSN of the
# client's Sentry project (an https URL). Set it in Vercel only; never commit a real DSN.
VITE_SENTRY_DSN=
# Optional tags. Empty: Vercel's VERCEL_ENV and VERCEL_GIT_COMMIT_SHA are used when present.
VITE_SENTRY_ENVIRONMENT=
VITE_SENTRY_RELEASE=
